# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password
DB_NAME=appresso
DB_POOL_MAX=20

# Servidor HTTP
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Seguridad y detección de fraude
HMAC_SECRET=reemplazar_con_llave_secreta_segura
APP_TIMEZONE=America/Bogota

# Umbrales y ventana deslizante en memoria (configurables por .env y en caliente vía PUT /fraud/thresholds/:franja)
FRAUD_WINDOW_SECONDS=3
THRESHOLD_MANANA=10
THRESHOLD_TARDE_NOCHE=6
THRESHOLD_NOCHE_MADRUGADA=3

# Configuración de Logs (Winston)
LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION=14d
